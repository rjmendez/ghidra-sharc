<?xml version="1.0" encoding="UTF-8"?>

<!-- SHARC+ (ADSP-2156x, ADSP-SC5xx): the 214xx code space with SW = 3*A - (A & 0xf0000)
     (sharcplus.slaspec); 48-bit blocks 0-3 at 0x90000/0xb0000/0xc0000/0xe0000 are sw:120000/
     160000/180000/1c0000.  With CMMR_SYSCTL.IIVT = 1 the 32 interrupt vectors, four ISA
     instructions apart (Core Programming Reference Table 4-46), start block 0. -->
<processor_spec>
  <programcounter register="PC"/>
  <volatile outputop="write_volatile" inputop="read_volatile">
    <range space="dm" first="0x0" last="0x3ffff"/>
  </volatile>
  <context_data>
    <context_set space="sw">
      <set name="visa" val="1"/>
    </context_set>
    <context_set space="sw" first="0x120000" last="0x12017f">
      <set name="visa" val="0"/>
    </context_set>
  </context_data>
  <default_symbols>
    <symbol name="VEC_EMUI" address="sw:120000" entry="true"/>
    <symbol name="VEC_RSTI" address="sw:12000c" entry="true"/>
    <symbol name="VEC_PARI" address="sw:120024" entry="true"/>
    <symbol name="VEC_ILOPI" address="sw:120030" entry="true"/>
    <symbol name="VEC_CB7I" address="sw:12003c" entry="true"/>
    <symbol name="VEC_IICDI" address="sw:120048" entry="true"/>
    <symbol name="VEC_SOVFI" address="sw:120054" entry="true"/>
    <symbol name="VEC_ILADI" address="sw:120060" entry="true"/>
    <symbol name="VEC_TMZHI" address="sw:120084" entry="true"/>
    <symbol name="VEC_BKPI" address="sw:120090" entry="true"/>
    <symbol name="VEC_FIR" address="sw:12009c" entry="true"/>
    <symbol name="VEC_IIR" address="sw:1200a8" entry="true"/>
    <symbol name="VEC_SECI" address="sw:1200b4" entry="true"/>
    <symbol name="VEC_RINSEQI" address="sw:1200f0" entry="true"/>
    <symbol name="VEC_CB15I" address="sw:1200fc" entry="true"/>
    <symbol name="VEC_TMZLI" address="sw:120108" entry="true"/>
    <symbol name="VEC_FIXI" address="sw:120114" entry="true"/>
    <symbol name="VEC_FLTOI" address="sw:120120" entry="true"/>
    <symbol name="VEC_FLTUI" address="sw:12012c" entry="true"/>
    <symbol name="VEC_FLTII" address="sw:120138" entry="true"/>
    <symbol name="VEC_EMULI" address="sw:120144" entry="true"/>
    <symbol name="VEC_SFTOI" address="sw:120150" entry="true"/>
    <symbol name="VEC_SFT1I" address="sw:12015c" entry="true"/>
    <symbol name="VEC_SFT2I" address="sw:120168" entry="true"/>
    <symbol name="VEC_SFT3I" address="sw:120174" entry="true"/>
  </default_symbols>
</processor_spec>
